# Copy to cluster.env on each machine. No passwords or tokens belong here.
# Addresses below are documentation-only; replace all three.
NODE_IPS=(192.0.2.10 192.0.2.11 192.0.2.12)
MGMT_IF=eth0
RDMA_HCAS=rocep1s0f0,rocep1s0f1,roceP2p1s0f0,roceP2p1s0f1
DATA_DIR=/srv/deepseek-v41
NCCL_DIR=/srv/deepseek-v41/nccl/build/lib
IMAGE=deepseek-v41-flash-three-sparks:public-v1
API_HOST=127.0.0.1
# Network clients: set API_HOST=0.0.0.0 and create DATA_DIR/state/api-key,
# mode 0600, with a randomly generated secret. Never commit that file.
# Control plane uses MGMT_IF; NCCL's RDMA HCA selection is separate.
# The original deployment used three direct QSFP links and a subnet-aware
# NCCL build. Validate every pair before starting a distributed model.
